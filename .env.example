# ==============================================================================
# AMRUTAM TELEMEDICINE BACKEND — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server & Runtime Environment
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=amrutam-telemedicine-backend

# Database (PostgreSQL 16)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_secure_password
DATABASE_NAME=amrutam_telemedicine
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/amrutam_telemedicine?schema=public

# Redis (Caching, Redlock Distributed Locks & BullMQ Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Authentication & JWT Configuration
JWT_SECRET=super_secret_jwt_access_token_key_amrutam_2026_at_least_32_chars
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_amrutam_2026_at_least_32_chars
JWT_REFRESH_EXPIRATION=7d

# Two-Factor Authentication (MFA / TOTP)
MFA_SERVICE_NAME=AmrutamTelemedicine

# Rate Limiting (Requests per Window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Observability & Structured Logging
LOG_LEVEL=debug
METRICS_PORT=3000

